# Coherer 后端环境变量示例
# 复制为 backend/.env 后按需修改；.env 已被 gitignore，不会入库。
# 生产环境请使用真实密钥，并通过部署平台的密钥管理注入。

# PostgreSQL 密码（需与 deploy/.env 中一致）
COHERER_DB_PASSWORD=change-me

# 设备密钥加密主密钥：Base64 编码的 32 字节（AES-256-GCM）
# 生成示例：openssl rand -base64 32
COHERER_SECRET_KEY=change-me-32-bytes-base64

# JWT 签名密钥（至少 32 字节）
COHERER_JWT_SECRET=change-me-at-least-32-characters-long

# EMQX 内部回调共享令牌（需与 deploy/.env 一致）
COHERER_INTERNAL_TOKEN=change-me

# 首次启动创建的 admin 用户口令
COHERER_ADMIN_PASSWORD=change-me

# 后端 → EMQX：生产建议启用 TLS（8883）
COHERER_MQTT_BROKER_PORT=8883
COHERER_MQTT_TLS_ENABLED=true
COHERER_MQTT_CA_FILE=../deploy/certs/ca.crt
# 浏览器实时订阅地址：信任本地 CA 后可切换 WSS
# COHERER_MQTT_WS_URL=wss://localhost:8084/mqtt

# 后端 MQTT 服务账号口令
COHERER_INGEST_SECRET=change-me

# 浏览器实时订阅短时凭证签名密钥
COHERER_WEB_SECRET=change-me

# TDengine 密码
COHERER_TDENGINE_PASSWORD=change-me
