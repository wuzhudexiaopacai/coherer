# 基础设施环境变量示例
# 复制为 deploy/.env 后按需修改；.env 已被 gitignore，不会入库。
COHERER_DB_PASSWORD=change-me
# 与 backend/.env 的 COHERER_INTERNAL_TOKEN 保持一致
COHERER_INTERNAL_TOKEN=change-me
# EMQX Dashboard admin 口令
EMQX_DASHBOARD_PASSWORD=change-me
# Grafana admin 口令（首次启动时生效；至少 8 位）
GRAFANA_ADMIN_PASSWORD=change-me
# Redis 口令（必须设置，否则缓存与在线状态可被任意进程读写）
COHERER_REDIS_PASSWORD=change-me
# TDengine root 口令（首次启动由 tdengine-init 任务写入，需与 backend/.env 一致）
COHERER_TDENGINE_PASSWORD=change-me
# 告警通知 webhook（钉钉/企微/自建网关）；留空则只记录告警不发送
# ALERT_WEBHOOK_URL=https://example.com/alert

# 可选 S3/MinIO 固件存储（仅 docker-compose.s3.yml 使用）
MINIO_ROOT_USER=coherer
MINIO_ROOT_PASSWORD=change-me-min-8-chars
